    "# ====================================================\n",
    "# 🏠 China Real Estate Demand Prediction - Full Notebook\n",
    "# ====================================================\n",
    "\n",
    "# --- Import Libraries ---\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import TimeSeriesSplit\n",
    "from colorama import Fore, Style\n",
    "\n",
    "# --- Verify Dataset Paths ---\n",
    "for dirname, _, filenames in os.walk('/kaggle/input'):\n",
    "    for filename in filenames:\n",
    "        print(os.path.join(dirname, filename))\n",
    "\n",
    "# ================================================================\n",
    "#  Custom Scoring Function (for validation)\n",
    "# ================================================================\n",
    "def custom_score(y_true, y_pred, eps=1e-12):\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    if y_true.size == 0:\n",
    "        raise ValueError('empty array')\n",
    "    if (y_true < 0).any():\n",
    "        raise ValueError('negative y_true')\n",
    "    if (~ np.isfinite(y_pred)).any():\n",
    "        raise ValueError('infinite y_pred')\n",
    "\n",
    "    ape = np.abs((y_true - y_pred) / np.maximum(y_true, eps))\n",
    "    good_mask = ape <= 1.0\n",
    "    good_rate = good_mask.mean()\n",
    "    if good_rate < 0.7:\n",
    "        return {'score': 0, 'good_rate': good_rate, 'str': f\"{Fore.RED}score={0:.3f} {good_rate=:.3f}{Style.RESET_ALL}\"}\n",
    "\n",
    "    good_ape = ape[good_mask]\n",
    "    mape = np.mean(good_ape)\n",
    "    scaled_mape = mape / good_rate\n",
    "    score = 1 - scaled_mape\n",
    "    return {'score': score, 'good_rate': good_rate, 'str': f\"{score=:.3f} {good_rate=:.3f}\"}\n",
    "\n",
    "# ================================================================\n",
    "#  Load Data\n",
    "# ================================================================\n",
    "path = '/kaggle/input/china-real-estate-demand-prediction'\n",
    "\n",
    "ci = pd.read_csv(f'{path}/train/city_indexes.csv')\n",
    "csi = pd.read_csv(f'{path}/train/city_search_index.csv')\n",
    "sp = pd.read_csv(f'{path}/train/sector_POI.csv')\n",
    "train_lt = pd.read_csv(f'{path}/train/land_transactions.csv')\n",
    "train_ltns = pd.read_csv(f'{path}/train/land_transactions_nearby_sectors.csv')\n",
    "train_pht = pd.read_csv(f'{path}/train/pre_owned_house_transactions.csv')\n",
    "train_phtns = pd.read_csv(f'{path}/train/pre_owned_house_transactions_nearby_sectors.csv')\n",
    "train_nht = pd.read_csv(f'{path}/train/new_house_transactions.csv')\n",
    "train_nhtns = pd.read_csv(f'{path}/train/new_house_transactions_nearby_sectors.csv')\n",
    "test = pd.read_csv(f'{path}/test.csv')\n",
    "\n",
    "# ================================================================\n",
    "#  Preprocessing\n",
    "# ================================================================\n",
    "month_codes = {\n",
    "    'Jan': 1, 'Feb': 2, 'Mar': 3, 'Apr': 4,\n",
    "    'May': 5, 'Jun': 6, 'Jul': 7, 'Aug': 8,\n",
    "    'Sep': 9, 'Oct': 10, 'Nov': 11, 'Dec': 12\n",
    "}\n",
    "\n",
    "test_id = test.id.str.split('_', expand=True)\n",
    "test['month'] = test_id[0]\n",
    "test['sector'] = test_id[1]\n",
    "del test_id\n",
    "\n",
    "for df in [train_lt, train_ltns, train_pht, train_phtns, train_nht, train_nhtns, csi, sp, test]:\n",
    "    if df is not csi:\n",
    "        df['sector_id'] = df.sector.str.slice(7, None).astype(int)\n",
    "    if df is not sp:\n",
    "        df['year'] = df.month.str.slice(0, 4).astype(int)\n",
    "        df['month'] = df.month.str.slice(5, None).map(month_codes)\n",
    "        df['time'] = (df['year'] - 2019) * 12 + df['month'] - 1\n",
    "\n",
    "# ================================================================\n",
    "#  Prepare Target Data\n",
    "# ================================================================\n",
    "amount_new_house_transactions = train_nht.set_index(['time', 'sector_id']).amount_new_house_transactions.unstack()\n",
    "amount_new_house_transactions = amount_new_house_transactions.fillna(0)\n",
    "amount_new_house_transactions[95] = 0  # Add missing sector\n",
    "amount_new_house_transactions = amount_new_house_transactions[np.arange(1, 97)]\n",
    "amount_new_house_transactions = amount_new_house_transactions.astype(int)\n",
    "\n",
    "# ================================================================\n",
    "#  Visualization (Optional)\n",
    "# ================================================================\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.title('Total New House Transactions Over Time')\n",
    "plt.plot(amount_new_house_transactions.sum(axis=1), label='Total amount')\n",
    "plt.xlabel('time (months)')\n",
    "plt.ylabel('Sum of amount_new_house_transactions')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "# ================================================================\n",
    "#  Baseline Model\n",
    "# ================================================================\n",
    "t1 = 6  # months for geometric mean\n",
    "t2 = 6  # months which must be nonzero\n",
    "cv = TimeSeriesSplit(n_splits=4, test_size=12)\n",
    "\n",
    "true, oof = [], []\n",
    "for fold, (idx_tr, idx_va) in enumerate(cv.split(amount_new_house_transactions)):\n",
    "    print(f\"# Fold {fold}: train on months {idx_tr.min()}..{idx_tr.max()}, validate on months {idx_va.min()}..{idx_va.max()}\")\n",
    "    a_tr = amount_new_house_transactions.iloc[idx_tr]\n",
    "    a_va = amount_new_house_transactions.iloc[idx_va]\n",
    "\n",
    "    a_pred = pd.DataFrame(\n",
    "        {time: np.exp(np.log(a_tr.tail(t1)).mean(axis=0)) for time in idx_va}\n",
    "    ).T\n",
    "    a_pred.loc[:, a_tr.tail(t2).min(axis=0) == 0] = 0\n",
    "    a_pred.index.rename('time', inplace=True)\n",
    "    print(f\"# Fold {fold}: {custom_score(a_va, a_pred)['str']}\\n\")\n",
    "    true.append(a_va)\n",
    "    oof.append(a_pred)\n",
    "\n",
    "print(f\"# Overall {custom_score(pd.concat(true), pd.concat(oof))['str']} {t1=} {t2=}\\n\")\n",
    "\n",
    "# ================================================================\n",
    "#  Generate Test Predictions\n",
    "# ================================================================\n",
    "a_tr = amount_new_house_transactions\n",
    "a_pred = pd.DataFrame(\n",
    "    {time: np.exp(np.log(a_tr.tail(t1)).mean(axis=0)) for time in np.arange(67, 79)}\n",
    ").T\n",
    "a_pred.loc[:, a_tr.tail(t2).min(axis=0) == 0] = 0\n",
    "a_pred.index.rename('time', inplace=True)\n",
    "\n",
    "# ================================================================\n",
    "#  Create Final Submission\n",
    "# ================================================================\n",
    "test['amount_new_house_transactions_12_months_later'] = a_pred.T.unstack().values\n",
    "submission = test[['id', 'amount_new_house_transactions_12_months_later']]\n",
    "submission.to_csv('submission.csv', index=False)\n",
    "\n",
    "print(\"✅ Submission file created successfully: submission.csv\")\n",
    "print(submission.shape)\n",
    "submission.head()"
   ]
  }
